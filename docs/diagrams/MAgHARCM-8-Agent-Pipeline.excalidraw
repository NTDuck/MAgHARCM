    },
    {
      "type": "text",
      "id": "c2_body",
      "x": 42,
      "y": 492,
      "width": 443,
      "height": 69,
      "text": "Builds static and dynamic representations of the source tree.\nUses Tree-Sitter for AST parsing, runs dynamic invariant mining\n(pointer nullability, allocation ranges) from test executions, maps\nobsolete third-party libraries to idiomatic target crates, and\nselects the global migration strategy (Big Bang / Incremental).",
      "originalText": "Builds static and dynamic representations of the source tree.\nUses Tree-Sitter for AST parsing, runs dynamic invariant mining\n(pointer nullability, allocation ranges) from test executions, maps\nobsolete third-party libraries to idiomatic target crates, and\nselects the global migration strategy (Big Bang / Incremental).",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "strokeColor": "#495057",
      "lineHeight": 1.25,
      "baseline": 9
    },
