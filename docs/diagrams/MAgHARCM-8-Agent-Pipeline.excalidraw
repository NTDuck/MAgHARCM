    {
      "type": "text",
      "id": "c1_body",
      "x": 54,
      "y": 150,
      "width": 251,
      "height": 110,
      "text": "Legacy software migration starts in\nversion control history before\ntouching source files. Analyzing years\nof git commit churn, directory\nevolution, and tacit naming patterns\nexposes true component boundaries and\nhidden co-change couplings that formal\nspecifications omit.",
      "originalText": "Legacy software migration starts in\nversion control history before\ntouching source files. Analyzing years\nof git commit churn, directory\nevolution, and tacit naming patterns\nexposes true component boundaries and\nhidden co-change couplings that formal\nspecifications omit.",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "strokeColor": "#495057",
      "lineHeight": 1.25,
      "baseline": 9
    },
