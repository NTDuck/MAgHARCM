      "type": "text",
      "id": "c2_title",
      "x": 42,
      "y": 470,
      "width": 273,
      "height": 17,
      "text": "Deep Codebase & Invariant Profiling",
      "originalText": "Deep Codebase & Invariant Profiling",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "strokeColor": "#1e1e1e",
      "lineHeight": 1.25,
