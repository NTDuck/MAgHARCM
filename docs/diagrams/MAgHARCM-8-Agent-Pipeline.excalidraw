    {
      "type": "text",
      "id": "c6_title",
      "x": 1852,
      "y": 745,
      "width": 281,
      "height": 17,
      "text": "Cascaded Toolchain Build & Test Gate",
      "originalText": "Cascaded Toolchain Build & Test Gate",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "strokeColor": "#1e1e1e",
      "lineHeight": 1.25,
      "baseline": 11
    },
    {
      "type": "text",
      "id": "c6_body",
      "x": 1852,
      "y": 767,
      "width": 291,
      "height": 110,
      "text": "Executes target compiler and test tools in a\nstrict cascade: AST syntax check ->\ntoolchain compilation -> test suite run. Co-\ntranslates and synthesizes tests, detects\ncoverage plateaus, and enforces a test-\nweakening guard that rejects test suites\nsilently simplified or loosened by the\nmodel.",
      "originalText": "Executes target compiler and test tools in a\nstrict cascade: AST syntax check ->\ntoolchain compilation -> test suite run. Co-\ntranslates and synthesizes tests, detects\ncoverage plateaus, and enforces a test-\nweakening guard that rejects test suites\nsilently simplified or loosened by the\nmodel.",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "strokeColor": "#495057",
      "lineHeight": 1.25,
      "baseline": 9
    },
