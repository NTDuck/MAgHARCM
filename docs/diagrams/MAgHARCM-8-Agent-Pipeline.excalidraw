      "x": 47,
      "y": 185,
      "width": 258,
      "height": 17,
      "text": "Pre-planning Software Archaeology",
      "originalText": "Pre-planning Software Archaeology",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
