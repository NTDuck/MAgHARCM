      "x": 1862,
      "y": 400,
      "width": 250,
      "height": 17,
      "text": "Multi-Judge Behavioral Consensus",
      "originalText": "Multi-Judge Behavioral Consensus",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
