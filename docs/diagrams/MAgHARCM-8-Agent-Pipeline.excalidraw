{"elements": [{"type": "cameraUpdate", "width": 800, "height": 600, "x": -40, "y": -40}, {"type": "text", "id": "title", "x": 330, "y": 8, "text": "MAgHARCM - 8-Agent Translation Pipeline", "fontSize": 26, "strokeColor": "#1e1e1e"}, {"type": "text", "id": "subtitle", "x": 238, "y": 46, "text": "Legacy repository -> validated, tested target-language code | typed blackboard state S | bounded repair cycle", "fontSize": 15, "strokeColor": "#495057"}, {"type": "rectangle", "id": "leg1", "x": 300, "y": 76, "width": 34, "height": 22, "backgroundColor": "#a5d8ff", "fillStyle": "solid", "roundness": {"type": 3}, "strokeWidth": 1}, {"type": "text", "id": "leg1t", "x": 340, "y": 79, "text": "Agent", "fontSize": 14, "strokeColor": "#1e1e1e"}, {"type": "ellipse", "id": "leg2", "x": 408, "y": 72, "width": 34, "height": 30, "backgroundColor": "#f1f3f5", "fillStyle": "solid", "strokeStyle": "dashed", "strokeWidth": 1}, {"type": "text", "id": "leg2t", "x": 448, "y": 79, "text": "Typed artifact (interim)", "fontSize": 14, "strokeColor": "#1e1e1e"}, {"type": "diamond", "id": "leg3", "x": 660, "y": 68, "width": 34, "height": 36, "backgroundColor": "#f1f3f5", "fillStyle": "solid", "strokeStyle": "dashed", "strokeWidth": 1}, {"type": "text", "id": "leg3t", "x": 700, "y": 79, "text": "Decision", "fontSize": 14, "strokeColor": "#1e1e1e"}, {"type": "arrow", "id": "leg4", "x": 810, "y": 87, "width": 40, "height": 0, "points": [[0, 0], [40, 0]], "strokeColor": "#ef4444", "strokeWidth": 2, "endArrowhead": "arrow"}, {"type": "text", "id": "leg4t", "x": 856, "y": 79, "text": "repair cycle", "fontSize": 14, "strokeColor": "#ef4444"}, {"type": "arrow", "id": "leg5", "x": 980, "y": 87, "width": 40, "height": 0, "points": [[0, 0], [40, 0]], "strokeColor": "#2f9e44", "strokeWidth": 2, "endArrowhead": "arrow"}, {"type": "text", "id": "leg5t", "x": 1026, "y": 79, "text": "termination (END)", "fontSize": 14, "strokeColor": "#2f9e44"}, {"type": "cameraUpdate", "width": 800, "height": 600, "x": -40, "y": 60}, {"type": "ellipse", "id": "repo", "x": 310, "y": 180, "width": 270, "height": 64, "backgroundColor": "#e9ecef", "fillStyle": "solid", "strokeStyle": "dashed", "strokeWidth": 2, "label": {"text": "Legacy Source Repository\nC sources | git history | Makefile", "fontSize": 14}}, {"type": "rectangle", "id": "a1", "x": 300, "y": 272, "width": 270, "height": 84, "backgroundColor": "#a5d8ff", "fillStyle": "solid", "roundness": {"type": 3}, "label": {"text": "1. Archaeologist Agent", "fontSize": 16}}, {"type": "text", "id": "s1_l0", "x": 18, "y": 266.0, "text": "Pre-planning software archaeology", "fontSize": 14, "strokeColor": "#495057"}, {"type": "text", "id": "s1_l1", "x": 18, "y": 284.2, "text": "on the legacy tree BEFORE any code", "fontSize": 14, "strokeColor": "#495057"}, {"type": "text", "id": "s1_l2", "x": 18, "y": 302.4, "text": "is written:", "fontSize": 14, "strokeColor": "#495057"}, {"type": "text", "id": "s1_l3", "x": 18, "y": 320.6, "text": "- git churn hotspots + Jaccard", "fontSize": 14, "strokeColor": "#495057"}, {"type": "text", "id": "s1_l4", "x": 18, "y": 338.8, "text": "  co-change coupling recovery", "fontSize": 14, "strokeColor": "#495057"}, {"type": "text", "id": "s1_l5", "x": 18, "y": 357.0, "text": "- design-rule hierarchy layering", "fontSize": 14, "strokeColor": "#495057"}, {"type": "text", "id": "s1_l6", "x": 18, "y": 375.2, "text": "  (L1/L2/L3 module boundaries)", "fontSize": 14, "strokeColor": "#495057"}, {"type": "text", "id": "s1_l7", "x": 18, "y": 393.4, "text": "- concept assignment + naming", "fontSize": 14, "strokeColor": "#495057"}, {"type": "text", "id": "s1_l8", "x": 18, "y": 411.6, "text": "  forensics / redocumentation", "fontSize": 14, "strokeColor": "#495057"}, {"type": "text", "id": "s1_l9", "x": 18, "y": 429.79999999999995, "text": "Its report steers every later agent.", "fontSize": 14, "strokeColor": "#495057"}, {"type": "arrow", "id": "e0", "x": 445, "y": 244, "width": 0, "height": 28, "points": [[0, 0], [0, 28]], "strokeColor": "#1e1e1e", "strokeWidth": 2, "endArrowhead": "arrow"}, {"type": "ellipse", "id": "p1", "x": 310, "y": 380, "width": 250, "height": 60, "backgroundColor": "#f1f3f5", "fillStyle": "solid", "strokeStyle": "dashed", "strokeWidth": 2, "label": {"text": "ArchaeologyReport\nboundaries - churn - design rules - naming", "fontSize": 13}}, {"type": "arrow", "id": "e1", "x": 445, "y": 356, "width": 0, "height": 24, "points": [[0, 0], [0, 24]], "strokeColor": "#1e1e1e", "strokeWidth": 2, "endArrowhead": "arrow"}, {"type": "rectangle", "id": "a2", "x": 300, "y": 476, "width": 270, "height": 84, "backgroundColor": "#c3fae8", "fillStyle": "solid", "roundness": {"type": 3}, "label": {"text": "2. Analyzer Agent", "fontSize": 16}}, {"type": "arrow", "id": "e2", "x": 445, "y": 440, "width": 0, "height": 36, "points": [[0, 0], [0, 36]], "strokeColor": "#1e1e1e", "strokeWidth": 2, "endArrowhead": "arrow"}, {"type": "ellipse", "id": "p2", "x": 310, "y": 584, "width": 250, "height": 60, "backgroundColor": "#f1f3f5", "fillStyle": "solid", "strokeStyle": "dashed", "strokeWidth": 2, "label": {"text": "AnalyzerOutput\nresearch + library map + target design", "fontSize": 13}}, {"type": "arrow", "id": "e3", "x": 445, "y": 560, "width": 0, "height": 24, "points": [[0, 0], [0, 24]], "strokeColor": "#1e1e1e", "strokeWidth": 2, "endArrowhead": "arrow"}, {"type": "rectangle", "id": "a3", "x": 300, "y": 680, "width": 270, "height": 84, "backgroundColor": "#fff3bf", "fillStyle": "solid", "roundness": {"type": 3}, "label": {"text": "3. Planner Agent", "fontSize": 16}}, {"type": "arrow", "id": "e4", "x": 445, "y": 644, "width": 0, "height": 36, "points": [[0, 0], [0, 36]], "strokeColor": "#1e1e1e", "strokeWidth": 2, "endArrowhead": "arrow"}, {"type": "ellipse", "id": "p3", "x": 310, "y": 788, "width": 250, "height": 60, "backgroundColor": "#f1f3f5", "fillStyle": "solid", "strokeStyle": "dashed", "strokeWidth": 2, "label": {"text": "PlanningOutput\nfragments - name map - skeletons - plan A/B", "fontSize": 13}}, {"type": "arrow", "id": "e5", "x": 445, "y": 764, "width": 0, "height": 24, "points": [[0, 0], [0, 24]], "strokeColor": "#1e1e1e", "strokeWidth": 2, "endArrowhead": "arrow"}, {"type": "rectangle", "id": "a4", "x": 300, "y": 884, "width": 270, "height": 84, "backgroundColor": "#d0bfff", "fillStyle": "solid", "roundness": {"type": 3}, "label": {"text": "4. Translator Agent", "fontSize": 16}}, {"type": "arrow", "id": "e6", "x": 445, "y": 848, "width": 0, "height": 36, "points": [[0, 0], [0, 36]], "strokeColor": "#1e1e1e", "strokeWidth": 2, "endArrowhead": "arrow"}, {"type": "ellipse", "id": "p4", "x": 310, "y": 992, "width": 250, "height": 60, "backgroundColor": "#f1f3f5", "fillStyle": "solid", "strokeStyle": "dashed", "strokeWidth": 2, "label": {"text": "TranslatedProject\nrel path -> translated source file", "fontSize": 13}}, {"type": "cameraUpdate", "width": 800, "height": 600, "x": 360, "y": 560}, {"type": "arrow", "id": "e6b", "x": 560, "y": 1022, "width": 260, "height": -46, "points": [[0, 0], [260, -46]], "strokeColor": "#1e1e1e", "strokeWidth": 2, "endArrowhead": "arrow", "label": {"text": "ckpt cT (PRIM-28)", "fontSize": 13}}, {"type": "cameraUpdate", "width": 800, "height": 600, "x": 400, "y": 560}, {"type": "rectangle", "id": "a5", "x": 820, "y": 932, "width": 270, "height": 84, "backgroundColor": "#eebefa", "fillStyle": "solid", "roundness": {"type": 3}, "label": {"text": "5. Reviewer Agent", "fontSize": 16}}, {"type": "text", "id": "s5_l0", "x": 1190, "y": 920.0, "text": "Role-flip de-hallucination gate", "fontSize": 14, "strokeColor": "#495057"}, {"type": "text", "id": "s5_l1", "x": 1190, "y": 938.2, "text": "(PRIM-25): re-prompts the model as an", "fontSize": 14, "strokeColor": "#495057"}, {"type": "text", "id": "s5_l2", "x": 1190, "y": 956.4, "text": "ADVERSARIAL reviewer - 'you must find", "fontSize": 14, "strokeColor": "#495057"}, {"type": "text", "id": "s5_l3", "x": 1190, "y": 974.6, "text": "at least one bug' - over the emitted", "fontSize": 14, "strokeColor": "#495057"}, {"type": "text", "id": "s5_l4", "x": 1190, "y": 992.8, "text": "files. Defeats sycophantic self-review:", "fontSize": 14, "strokeColor": "#495057"}, {"type": "text", "id": "s5_l5", "x": 1190, "y": 1011.0, "text": "hallucinated API calls are surfaced", "fontSize": 14, "strokeColor": "#495057"}, {"type": "text", "id": "s5_l6", "x": 1190, "y": 1029.2, "text": "here, before the compiler ever runs.", "fontSize": 14, "strokeColor": "#495057"}, {"type": "arrow", "id": "e7", "x": 955, "y": 932, "width": 0, "height": -28, "points": [[0, 0], [0, -28]], "strokeColor": "#1e1e1e", "strokeWidth": 2, "endArrowhead": "arrow"}, {"type": "ellipse", "id": "p5", "x": 830, "y": 844, "width": 250, "height": 60, "backgroundColor": "#f1f3f5", "fillStyle": "solid", "strokeStyle": "dashed", "strokeWidth": 2, "label": {"text": "ReviewerVerdict\ndefect-found flag + reason (per sample)", "fontSize": 13}}, {"type": "arrow", "id": "e8", "x": 955, "y": 844, "width": 0, "height": -24, "points": [[0, 0], [0, -24]], "strokeColor": "#1e1e1e", "strokeWidth": 2, "endArrowhead": "arrow"}, {"type": "cameraUpdate", "width": 800, "height": 600, "x": 400, "y": 360}, {"type": "rectangle", "id": "a6", "x": 820, "y": 736, "width": 270, "height": 84, "backgroundColor": "#ffd8a8", "fillStyle": "solid", "roundness": {"type": 3}, "label": {"text": "6. Validator Agent", "fontSize": 16}}, {"type": "text", "id": "s6_l0", "x": 1190, "y": 724.0, "text": "Multi-stage build/test cascade", "fontSize": 14, "strokeColor": "#495057"}, {"type": "text", "id": "s6_l1", "x": 1190, "y": 742.2, "text": "(PRIM-5/6/13/27):", "fontSize": 14, "strokeColor": "#495057"}, {"type": "text", "id": "s6_l2", "x": 1190, "y": 760.4, "text": "AST syntax check -> toolchain compile", "fontSize": 14, "strokeColor": "#495057"}, {"type": "text", "id": "s6_l3", "x": 1190, "y": 778.6, "text": "-> execute tests. Co-translates and", "fontSize": 14, "strokeColor": "#495057"}, {"type": "text", "id": "s6_l4", "x": 1190, "y": 796.8, "text": "synthesizes test suites, guards against", "fontSize": 14, "strokeColor": "#495057"}, {"type": "text", "id": "s6_l5", "x": 1190, "y": 815.0, "text": "ADVERSARIAL test-weakening (tests", "fontSize": 14, "strokeColor": "#495057"}, {"type": "text", "id": "s6_l6", "x": 1190, "y": 833.2, "text": "secretly loosened between iterations),", "fontSize": 14, "strokeColor": "#495057"}, {"type": "text", "id": "s6_l7", "x": 1190, "y": 851.4, "text": "detects coverage plateaus, emits the", "fontSize": 14, "strokeColor": "#495057"}, {"type": "text", "id": "s6_l8", "x": 1190, "y": 869.6, "text": "typed report that drives the branch.", "fontSize": 14, "strokeColor": "#495057"}, {"type": "arrow", "id": "e9", "x": 955, "y": 736, "width": 0, "height": -28, "points": [[0, 0], [0, -28]], "strokeColor": "#1e1e1e", "strokeWidth": 2, "endArrowhead": "arrow"}, {"type": "diamond", "id": "p6", "x": 800, "y": 608, "width": 310, "height": 100, "backgroundColor": "#f1f3f5", "fillStyle": "solid", "strokeStyle": "dashed", "strokeWidth": 2, "label": {"text": "ValidationReport\ntyped build/test verdict (branch input)", "fontSize": 13}}, {"type": "arrow", "id": "e10", "x": 955, "y": 608, "width": 0, "height": -36, "points": [[0, 0], [0, -36]], "strokeColor": "#ef4444", "strokeWidth": 2, "endArrowhead": "arrow"}, {"type": "text", "id": "failL", "x": 968, "y": 576, "text": "FAIL: gamma(s) = false", "fontSize": 14, "strokeColor": "#ef4444"}, {"type": "cameraUpdate", "width": 800, "height": 600, "x": 400, "y": 120}, {"type": "rectangle", "id": "a7", "x": 820, "y": 488, "width": 270, "height": 84, "backgroundColor": "#b2f2bb", "fillStyle": "solid", "roundness": {"type": 3}, "label": {"text": "7. Verdict Panel Agent", "fontSize": 16}}, {"type": "text", "id": "s7_l0", "x": 1190, "y": 476.0, "text": "Multi-judge consensus (PRIM-7):", "fontSize": 14, "strokeColor": "#495057"}, {"type": "text", "id": "s7_l1", "x": 1190, "y": 494.2, "text": "N independent judge agents score", "fontSize": 14, "strokeColor": "#495057"}, {"type": "text", "id": "s7_l2", "x": 1190, "y": 512.4, "text": "BEHAVIORAL EQUIVALENCE of translation", "fontSize": 14, "strokeColor": "#495057"}, {"type": "text", "id": "s7_l3", "x": 1190, "y": 530.6, "text": "vs. source. Optional deeper tiers:", "fontSize": 14, "strokeColor": "#495057"}, {"type": "text", "id": "s7_l4", "x": 1190, "y": 548.8, "text": "mock-based in-isolation validation,", "fontSize": 14, "strokeColor": "#495057"}, {"type": "text", "id": "s7_l5", "x": 1190, "y": 567.0, "text": "implementation-agnostic tests, and a", "fontSize": 14, "strokeColor": "#495057"}, {"type": "text", "id": "s7_l6", "x": 1190, "y": 585.2, "text": "WASM reference execution oracle.", "fontSize": 14, "strokeColor": "#495057"}, {"type": "text", "id": "s7_l7", "x": 1190, "y": 603.4, "text": "Majority verdict gates the release.", "fontSize": 14, "strokeColor": "#495057"}, {"type": "arrow", "id": "e11", "x": 955, "y": 488, "width": 0, "height": -28, "points": [[0, 0], [0, -28]], "strokeColor": "#1e1e1e", "strokeWidth": 2, "endArrowhead": "arrow"}, {"type": "ellipse", "id": "p7", "x": 830, "y": 400, "width": 250, "height": 60, "backgroundColor": "#f1f3f5", "fillStyle": "solid", "strokeStyle": "dashed", "strokeWidth": 2, "label": {"text": "VerdictReport\nmajority agree + disagreement list", "fontSize": 13}}, {"type": "arrow", "id": "e12", "x": 955, "y": 400, "width": 0, "height": -24, "points": [[0, 0], [0, -24]], "strokeColor": "#1e1e1e", "strokeWidth": 2, "endArrowhead": "arrow"}, {"type": "rectangle", "id": "a8", "x": 820, "y": 292, "width": 270, "height": 84, "backgroundColor": "#d0bfff", "fillStyle": "solid", "roundness": {"type": 3}, "label": {"text": "8. Recruiter Agent", "fontSize": 16}}, {"type": "text", "id": "s8_l0", "x": 1190, "y": 280.0, "text": "Dynamic iteration adaptation", "fontSize": 14, "strokeColor": "#495057"}, {"type": "text", "id": "s8_l1", "x": 1190, "y": 298.2, "text": "(PRIM-29, AgentVerse-style): on failure", "fontSize": 14, "strokeColor": "#495057"}, {"type": "text", "id": "s8_l2", "x": 1190, "y": 316.4, "text": "it switches the migration strategy via", "fontSize": 14, "strokeColor": "#495057"}, {"type": "text", "id": "s8_l3", "x": 1190, "y": 334.6, "text": "the try-and-fail registry AND re-recruits", "fontSize": 14, "strokeColor": "#495057"}, {"type": "text", "id": "s8_l4", "x": 1190, "y": 352.8, "text": "the agent/tool roster for the next pass", "fontSize": 14, "strokeColor": "#495057"}, {"type": "text", "id": "s8_l5", "x": 1190, "y": 371.0, "text": "-> emits a RecruitmentPlan, then", "fontSize": 14, "strokeColor": "#495057"}, {"type": "text", "id": "s8_l6", "x": 1190, "y": 389.2, "text": "re-enters the Translator (red arrow).", "fontSize": 14, "strokeColor": "#495057"}, {"type": "cameraUpdate", "width": 800, "height": 600, "x": -40, "y": 300}, {"type": "arrow", "id": "loop", "x": 820, "y": 334, "width": 248, "height": 592, "points": [[0, 0], [-160, 0], [-160, 592], [-248, 592]], "strokeColor": "#ef4444", "strokeWidth": 2, "endArrowhead": "arrow"}, {"type": "arrow", "id": "pass", "x": 1110, "y": 658, "width": 70, "height": -426, "points": [[0, 0], [70, 0], [70, -426], [-18, -426]], "strokeColor": "#2f9e44", "strokeWidth": 2, "endArrowhead": "arrow"}, {"type": "text", "id": "passL_l0", "x": 1124, "y": 620.0, "text": "PASS:", "fontSize": 14, "strokeColor": "#2f9e44"}, {"type": "text", "id": "passL_l1", "x": 1124, "y": 638.2, "text": "gamma(s) = true", "fontSize": 14, "strokeColor": "#2f9e44"}, {"type": "ellipse", "id": "fin", "x": 820, "y": 200, "width": 270, "height": 64, "backgroundColor": "#b2f2bb", "fillStyle": "solid", "strokeColor": "#2f9e44", "strokeWidth": 2, "label": {"text": "Final Translated Repository\nvalidated - tested - converged", "fontSize": 14}}, {"type": "cameraUpdate", "width": 1600, "height": 1200, "x": -40, "y": -10}, {"type": "rectangle", "id": "fzone", "x": 270, "y": 1080, "width": 1010, "height": 160, "backgroundColor": "#e5dbff", "fillStyle": "solid", "roundness": {"type": 3}, "strokeWidth": 1, "opacity": 30}, {"type": "text", "id": "fh", "x": 290, "y": 1090, "text": "Formal model", "fontSize": 17, "strokeColor": "#8b5cf6"}, {"type": "text", "id": "f1", "x": 290, "y": 1116, "text": "S = (Task, R, A, P, T, V, iter)   -- typed blackboard state; every artifact schema-versioned (PRIM-24)", "fontSize": 14, "strokeColor": "#1e1e1e"}, {"type": "text", "id": "f2", "x": 290, "y": 1138, "text": "f_i : S -> S,  i = 1..8          -- agents are total transitions on S; no peer pointers, communication only via S", "fontSize": 14, "strokeColor": "#1e1e1e"}, {"type": "text", "id": "f3", "x": 290, "y": 1160, "text": "G = (N, E),  N = {a1..a8, cT, cV, END};  forward chain a1->a2->a3->a4->cT->a5->a6->cV", "fontSize": 14, "strokeColor": "#1e1e1e"}, {"type": "text", "id": "f4", "x": 290, "y": 1182, "text": "delta(cV, s) = END                         if gamma(s)", "fontSize": 14, "strokeColor": "#1e1e1e"}, {"type": "text", "id": "f5", "x": 290, "y": 1204, "text": "             = (a7 ; a8 ; a4)(s)           otherwise   -- repair cycle re-enters at the Translator", "fontSize": 14, "strokeColor": "#1e1e1e"}, {"type": "text", "id": "f6", "x": 290, "y": 1226, "text": "gamma(s) := complete(s) OR V.allSuccess OR iter >= iter_max    (iter_max = 20;  |steps(G)| <= 50 => termination)", "fontSize": 14, "strokeColor": "#1e1e1e"}, {"type": "text", "id": "s2_l0", "x": 10, "y": 470.0, "text": "Profiles the source project and", "fontSize": 14, "strokeColor": "#495057"}, {"type": "text", "id": "s2_l1", "x": 10, "y": 488.2, "text": "selects the migration route:", "fontSize": 14, "strokeColor": "#495057"}, {"type": "text", "id": "s2_l2", "x": 10, "y": 506.4, "text": "- Tree-Sitter AST + directory pass", "fontSize": 14, "strokeColor": "#495057"}, {"type": "text", "id": "s2_l3", "x": 10, "y": 524.6, "text": "- SpecMiner invariant recovery", "fontSize": 14, "strokeColor": "#495057"}, {"type": "text", "id": "s2_l4", "x": 10, "y": 542.8, "text": "- library -> crate mapping", "fontSize": 14, "strokeColor": "#495057"}, {"type": "text", "id": "s2_l5", "x": 10, "y": 561.0, "text": "- feature/type compatibility checks", "fontSize": 14, "strokeColor": "#495057"}, {"type": "text", "id": "s2_l6", "x": 10, "y": 579.2, "text": "- strategy: BIG_BANG / PILOT /", "fontSize": 14, "strokeColor": "#495057"}, {"type": "text", "id": "s2_l7", "x": 10, "y": 597.4, "text": "  PARALLEL / INCREMENTAL", "fontSize": 14, "strokeColor": "#495057"}, {"type": "text", "id": "s3_l0", "x": 10, "y": 674.0, "text": "Turns analysis into an executable", "fontSize": 14, "strokeColor": "#495057"}, {"type": "text", "id": "s3_l1", "x": 10, "y": 692.2, "text": "order of work:", "fontSize": 14, "strokeColor": "#495057"}, {"type": "text", "id": "s3_l2", "x": 10, "y": 710.4, "text": "- atomic fragments per AST element", "fontSize": 14, "strokeColor": "#495057"}, {"type": "text", "id": "s3_l3", "x": 10, "y": 728.6, "text": "- reverse-topological ordering;", "fontSize": 14, "strokeColor": "#495057"}, {"type": "text", "id": "s3_l4", "x": 10, "y": 746.8, "text": "  back-edge scheduling for cycles", "fontSize": 14, "strokeColor": "#495057"}, {"type": "text", "id": "s3_l5", "x": 10, "y": 765.0, "text": "- compilable skeletons FIRST", "fontSize": 14, "strokeColor": "#495057"}, {"type": "text", "id": "s3_l6", "x": 10, "y": 783.2, "text": "- build-manifest rewriting", "fontSize": 14, "strokeColor": "#495057"}, {"type": "text", "id": "s4_l0", "x": 10, "y": 878.0, "text": "Produces target-language code:", "fontSize": 14, "strokeColor": "#495057"}, {"type": "text", "id": "s4_l1", "x": 10, "y": 896.2, "text": "- chunked dispatch: 1 bounded LLM", "fontSize": 14, "strokeColor": "#495057"}, {"type": "text", "id": "s4_l2", "x": 10, "y": 914.4, "text": "  call per fragment w/ state summary", "fontSize": 14, "strokeColor": "#495057"}, {"type": "text", "id": "s4_l3", "x": 10, "y": 932.6, "text": "- LSP-backed Navigator context", "fontSize": 14, "strokeColor": "#495057"}, {"type": "text", "id": "s4_l4", "x": 10, "y": 950.8, "text": "- iterative retrieval refinement", "fontSize": 14, "strokeColor": "#495057"}, {"type": "text", "id": "s4_l5", "x": 10, "y": 969.0, "text": "- REPAIR MODE: compiler diagnostics", "fontSize": 14, "strokeColor": "#495057"}, {"type": "text", "id": "s4_l6", "x": 10, "y": 987.2, "text": "  + test failures -> coding model", "fontSize": 14, "strokeColor": "#495057"}, {"type": "text", "id": "loopL_l0", "x": 590, "y": 296.0, "text": "repair re-entry: strategy", "fontSize": 14, "strokeColor": "#ef4444"}, {"type": "text", "id": "loopL_l1", "x": 590, "y": 314.2, "text": "switch + diagnostics", "fontSize": 14, "strokeColor": "#ef4444"}]}