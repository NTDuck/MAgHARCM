    {
      "type": "text",
      "id": "c6_title",
      "x": 1862,
      "y": 760,
      "width": 281,
      "height": 17,
      "text": "Cascaded Toolchain Build & Test Gate",
      "originalText": "Cascaded Toolchain Build & Test Gate",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "strokeColor": "#1e1e1e",
      "lineHeight": 1.25,
      "baseline": 11
    },
    {
      "type": "text",
      "id": "c6_body",
      "x": 1862,
      "y": 782,
      "width": 416,
      "height": 69,
      "text": "Executes target compiler and test tools in a strict cascade:\nAST syntax check -> toolchain compilation -> test suite run.\nCo-translates and synthesizes tests, detects coverage plateaus,\nand enforces a test-weakening guard that rejects test suites\nsilently simplified or loosened by the model.",
      "originalText": "Executes target compiler and test tools in a strict cascade:\nAST syntax check -> toolchain compilation -> test suite run.\nCo-translates and synthesizes tests, detects coverage plateaus,\nand enforces a test-weakening guard that rejects test suites\nsilently simplified or loosened by the model.",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "strokeColor": "#495057",
      "lineHeight": 1.25,
      "baseline": 9
    },
