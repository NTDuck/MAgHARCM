    },
    {
      "type": "text",
      "id": "c1_body",
      "x": 42,
      "y": 202,
      "width": 410,
      "height": 69,
      "text": "Analyzes legacy Git commits, directory layout, and identifier\npatterns BEFORE code is touched. Recovers co-change coupling\nand churn hotspots, clusters domain concepts, and reconstructs\narchitectural layers so downstream LLMs understand true module\nboundaries without hallucinating legacy idiosyncrasies.",
      "originalText": "Analyzes legacy Git commits, directory layout, and identifier\npatterns BEFORE code is touched. Recovers co-change coupling\nand churn hotspots, clusters domain concepts, and reconstructs\narchitectural layers so downstream LLMs understand true module\nboundaries without hallucinating legacy idiosyncrasies.",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "strokeColor": "#495057",
      "lineHeight": 1.25,
      "baseline": 9
    },
