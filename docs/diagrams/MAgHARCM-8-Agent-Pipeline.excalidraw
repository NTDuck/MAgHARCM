    {
      "type": "text",
      "id": "c5_title",
      "x": 1852,
      "y": 1025,
      "width": 297,
      "height": 17,
      "text": "Adversarial Role-Flip De-Hallucination",
      "originalText": "Adversarial Role-Flip De-Hallucination",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
