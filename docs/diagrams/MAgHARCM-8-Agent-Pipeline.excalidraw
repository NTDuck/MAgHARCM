    {
      "type": "text",
      "id": "c4_title",
      "x": 42,
      "y": 1050,
      "width": 258,
      "height": 17,
      "text": "Context-Aware Chunked Translation",
      "originalText": "Context-Aware Chunked Translation",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "strokeColor": "#1e1e1e",
      "lineHeight": 1.25,
      "baseline": 11
    },
    {
      "type": "text",
      "id": "c4_body",
      "x": 42,
      "y": 1072,
      "width": 443,
      "height": 69,
      "text": "Translates one AST fragment at a time while threading a rolling\nsummary of translated state to maintain global coherence. Queries\nLSP for definitions/references on demand without blowing context.\nIn repair passes, incorporates compiler diagnostics and test traces\nfor targeted bug fixing.",
      "originalText": "Translates one AST fragment at a time while threading a rolling\nsummary of translated state to maintain global coherence. Queries\nLSP for definitions/references on demand without blowing context.\nIn repair passes, incorporates compiler diagnostics and test traces\nfor targeted bug fixing.",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "strokeColor": "#495057",
      "lineHeight": 1.25,
      "baseline": 9
    },
