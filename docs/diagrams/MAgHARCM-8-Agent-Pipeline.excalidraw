    {
      "type": "text",
      "id": "fh",
      "x": 290,
      "y": 1090,
      "text": "Formal model",
      "fontSize": 17,
      "strokeColor": "#8b5cf6",
      "width": 123,
      "height": 22,
      "originalText": "Formal model",
      "fontFamily": 1,
      "lineHeight": 1.25,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "baseline": 15
    },
    {
      "type": "text",
      "id": "f1",
      "x": 290,
      "y": 1116,
      "text": "S = (Task, R, A, P, T, V, iter)   -- typed blackboard state; every artifact schema-versioned (PRIM-24)",
      "fontSize": 14,
      "strokeColor": "#1e1e1e",
      "width": 857,
      "height": 18,
      "originalText": "S = (Task, R, A, P, T, V, iter)   -- typed blackboard state; every artifact schema-versioned (PRIM-24)",
      "fontFamily": 1,
      "lineHeight": 1.25,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "baseline": 12
    },
    {
      "type": "text",
      "id": "f2",
      "x": 290,
      "y": 1138,
      "text": "f_i : S -> S,  i = 1..8          -- agents are total transitions on S; no peer pointers, communication only via S",
      "fontSize": 14,
      "strokeColor": "#1e1e1e",
      "width": 950,
      "height": 18,
      "originalText": "f_i : S -> S,  i = 1..8          -- agents are total transitions on S; no peer pointers, communication only via S",
      "fontFamily": 1,
      "lineHeight": 1.25,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "baseline": 12
    },
    {
      "type": "text",
      "id": "f3",
      "x": 290,
      "y": 1160,
      "text": "G = (N, E),  N = {a1..a8, cT, cV, END};  forward chain a1->a2->a3->a4->cT->a5->a6->cV",
      "fontSize": 14,
      "strokeColor": "#1e1e1e",
      "width": 714,
      "height": 18,
      "originalText": "G = (N, E),  N = {a1..a8, cT, cV, END};  forward chain a1->a2->a3->a4->cT->a5->a6->cV",
      "fontFamily": 1,
      "lineHeight": 1.25,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "baseline": 12
    },
    {
      "type": "text",
      "id": "f4",
      "x": 290,
      "y": 1182,
      "text": "delta(cV, s) = END                         if gamma(s)",
      "fontSize": 14,
      "strokeColor": "#1e1e1e",
      "width": 454,
      "height": 18,
      "originalText": "delta(cV, s) = END                         if gamma(s)",
      "fontFamily": 1,
      "lineHeight": 1.25,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "baseline": 12
    },
    {
      "type": "text",
      "id": "f5",
      "x": 290,
      "y": 1204,
      "text": "             = (a7 ; a8 ; a4)(s)           otherwise   -- repair cycle re-enters at the Translator",
      "fontSize": 14,
      "strokeColor": "#1e1e1e",
      "width": 824,
      "height": 18,
      "originalText": "             = (a7 ; a8 ; a4)(s)           otherwise   -- repair cycle re-enters at the Translator",
      "fontFamily": 1,
      "lineHeight": 1.25,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "baseline": 12
    },
    {
      "type": "text",
      "id": "f6",
      "x": 290,
      "y": 1226,
      "text": "gamma(s) := complete(s) OR V.allSuccess OR iter >= iter_max    (iter_max = 20;  |steps(G)| <= 50 => termination)",
      "fontSize": 14,
      "strokeColor": "#1e1e1e",
      "width": 941,
      "height": 18,
      "originalText": "gamma(s) := complete(s) OR V.allSuccess OR iter >= iter_max    (iter_max = 20;  |steps(G)| <= 50 => termination)",
      "fontFamily": 1,
      "lineHeight": 1.25,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "baseline": 12
    },
