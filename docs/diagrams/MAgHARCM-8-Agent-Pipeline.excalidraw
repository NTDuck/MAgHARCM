    {
      "type": "text",
      "id": "c8_body",
      "x": 1444,
      "y": 705,
      "width": 245,
      "height": 110,
      "text": "If compilation fails, tests break, or\ntranslation progress plateaus, the\nadaptive controller intervenes.\nDiagnosing failure modes, it\nreconfigures translation strategies,\nre-tunes model hyperparameters, and\nbundles distilled diagnostic context\nto re-enter the translation stage.",
      "originalText": "If compilation fails, tests break, or\ntranslation progress plateaus, the\nadaptive controller intervenes.\nDiagnosing failure modes, it\nreconfigures translation strategies,\nre-tunes model hyperparameters, and\nbundles distilled diagnostic context\nto re-enter the translation stage.",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "strokeColor": "#495057",
      "lineHeight": 1.25,
      "baseline": 9
    },
