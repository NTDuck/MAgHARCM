    },
    {
      "type": "text",
      "id": "c8_body",
      "x": 1896,
      "y": 854,
      "width": 281,
      "height": 120,
      "text": "When tests fail or progress plateaus,\nthe adaptive meta-controller assumes\ncommand. It diagnoses systemic\nbottlenecks, reconfigures migration\nstrategies, tunes model parameters, and\ndistills high-priority diagnostics into\nan actionable repair context that re-\nenters the translation loop.",
      "originalText": "When tests fail or progress plateaus,\nthe adaptive meta-controller assumes\ncommand. It diagnoses systemic\nbottlenecks, reconfigures migration\nstrategies, tunes model parameters, and\ndistills high-priority diagnostics into\nan actionable repair context that re-\nenters the translation loop.",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "strokeColor": "#495057",
      "lineHeight": 1.25,
      "baseline": 10
    },
