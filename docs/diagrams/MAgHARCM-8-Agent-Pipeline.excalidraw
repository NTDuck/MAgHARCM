    {
      "type": "text",
      "id": "c1_body",
      "x": 81,
      "y": 159,
      "width": 281,
      "height": 120,
      "text": "Legacy software migration starts in\nversion control history before touching\nsource files. Analyzing years of git\ncommit churn, directory evolution, and\ntacit naming patterns exposes true\ncomponent boundaries and hidden co-\nchange couplings that formal\nspecifications omit.",
      "originalText": "Legacy software migration starts in\nversion control history before touching\nsource files. Analyzing years of git\ncommit churn, directory evolution, and\ntacit naming patterns exposes true\ncomponent boundaries and hidden co-\nchange couplings that formal\nspecifications omit.",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "strokeColor": "#495057",
      "lineHeight": 1.25,
