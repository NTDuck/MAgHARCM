      "x": 1852,
      "y": 380,
      "width": 250,
      "height": 17,
      "text": "Multi-Judge Behavioral Consensus",
      "originalText": "Multi-Judge Behavioral Consensus",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
