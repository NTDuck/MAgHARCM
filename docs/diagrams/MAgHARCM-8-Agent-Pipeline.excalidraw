    {
      "type": "text",
      "id": "c4_title",
      "x": 47,
      "y": 1025,
      "width": 258,
      "height": 17,
      "text": "Context-Aware Chunked Translation",
      "originalText": "Context-Aware Chunked Translation",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "strokeColor": "#1e1e1e",
      "lineHeight": 1.25,
      "baseline": 11
    },
    {
      "type": "text",
      "id": "c4_body",
      "x": 47,
      "y": 1047,
      "width": 284,
      "height": 97,
      "text": "Translates one AST fragment at a time while\nthreading a rolling summary of translated\nstate to maintain global coherence. Queries\nLSP for definitions/references on demand\nwithout blowing context. In repair passes,\nincorporates compiler diagnostics and test\ntraces for targeted bug fixing.",
      "originalText": "Translates one AST fragment at a time while\nthreading a rolling summary of translated\nstate to maintain global coherence. Queries\nLSP for definitions/references on demand\nwithout blowing context. In repair passes,\nincorporates compiler diagnostics and test\ntraces for targeted bug fixing.",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "strokeColor": "#495057",
      "lineHeight": 1.25,
      "baseline": 9
    },
