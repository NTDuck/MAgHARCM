{
  "schema_version": 1,
  "diagram_type": "lifecycle",
  "meta": {
    "title": "MAgHARCM Translation Lifecycle State Machine",
    "subtitle": "State transitions across analysis, chunked translation, validation gates, checkpoints, and repair cycles.",
    "output": "docs/.paper/figures/translation-lifecycle.html",
    "viewBox": [980, 660]
  },
  "lanes": [
    { "id": "main", "label": "Pipeline Phases" },
    { "id": "events", "label": "Checkpoints & Stalls" },
    { "id": "terminal", "label": "Terminal Exits" }
  ],
  "states": [
    { "id": "intake", "type": "start", "label": "Intake", "sublabel": "Manifest Parsed", "lane": "main", "col": 0, "step": "01", "tag": "entry" },
    { "id": "analyzing", "type": "active", "label": "Analyzing", "sublabel": "Müller Strategy", "lane": "main", "col": 1, "step": "02", "tag": "reasoning" },
    { "id": "planning", "type": "active", "label": "Planning", "sublabel": "Reverse-Topo DAG", "lane": "main", "col": 2, "step": "03", "tag": "back-edge" },
    { "id": "translating", "type": "active", "label": "Translating", "sublabel": "Chunked Dispatch", "lane": "main", "col": 3, "step": "04", "tag": "coding" },
    { "id": "completed", "type": "success", "label": "Converged", "sublabel": "100% Tests Pass", "lane": "main", "col": 4, "step": "05", "tag": "success" },
    { "id": "checkpoint", "type": "waiting", "label": "Checkpointed", "sublabel": "State Snapshot", "lane": "events", "col": 0, "tag": "resume" },
    { "id": "repairing", "type": "failure", "label": "Repair Mode", "sublabel": "Compiler Triage", "lane": "events", "col": 1, "tag": "iter <= K" },
    { "id": "plateau", "type": "waiting", "label": "Plateau Stalled", "sublabel": "Coverage Stagnant", "lane": "events", "col": 2, "tag": "stall" },
    { "id": "exhausted", "type": "failure", "label": "Budget Ceiling", "sublabel": "Max Iterations", "lane": "terminal", "col": 1, "tag": "terminal" },
    { "id": "weakened", "type": "failure", "label": "Test Weakened", "sublabel": "Assertion Dropped", "lane": "terminal", "col": 2, "tag": "terminal" }
  ],
  "transitions": [
    { "from": "planning", "to": "checkpoint", "variant": "default", "fromSide": "bottom", "toSide": "top", "route": "straight" },
    { "from": "translating", "to": "repairing", "variant": "default", "fromSide": "bottom", "toSide": "top", "route": "straight" },
    { "from": "repairing", "to": "exhausted", "variant": "security", "fromSide": "bottom", "toSide": "top", "route": "straight" },
    { "from": "translating", "to": "plateau", "variant": "default", "fromSide": "bottom", "toSide": "top", "route": "drop" },
    { "from": "plateau", "to": "weakened", "variant": "security", "fromSide": "bottom", "toSide": "top", "route": "straight" }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "Forward Rail",
      "items": [
        "Ordered progression: Intake -> Analyzing -> Planning -> Translating -> Converged",
        "Deterministic reverse-topological order resolves callee dependencies first",
        "Converged terminal state reached upon 100% test pass rate"
      ]
    },
    {
      "dot": "amber",
      "title": "State Checkpoints & Stalls",
      "items": [
        "State serialized under .artifacts/<run-id>/checkpoints/ after each iteration",
        "Coverage plateau detector halts zero-gain repair cycles",
        "Idempotent resume restarts from the latest checkpoint snapshot"
      ]
    },
    {
      "dot": "rose",
      "title": "Defense & Failure Exits",
      "items": [
        "Repair loop triages compiler diagnostics and borrow-checker errors",
        "Adversarial weakening guard halts execution if test assertions are removed",
        "Budget ceiling enforces bounded local model execution"
      ]
    }
  ]
}
