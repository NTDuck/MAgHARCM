    {
      "dot": "cyan",
      "title": "Local SLM Pipeline",
      "items": [
        "Eight-agent Archaeology -> Analyze -> Plan -> Translate -> Review -> Validate -> Verdict -> Recruit loop",
        "Qwen3-30B Thinking reasoning model paired with Qwen3-4B Instruct coding model",
        "100% self-hosted via Ollama with zero external cloud dependencies"
      ]
    },
    {
      "dot": "emerald",
      "title": "Agent Decomposition",
      "items": [
        "Archaeologist emits concept map + design-rule hierarchy before planning",
        "Analyzer emits Source Research, Library Analysis, Target Design",
        "Planner fragments AST, resolves names, builds reverse-topo DAG + skeletons",
        "Translator executes Part A (source) + Part B (tests) in topological order",
        "RoleFlipReviewer runs communicative de-hallucination checks",
        "Validator runs AST -> compiler -> tests -> guard -> plateau cascade",
        "VerdictPanel applies multi-judge consensus, Recruiter re-plans as needed"
      ]
    },
    {
      "dot": "amber",
      "title": "Strategy Registry & Repair Loop",
      "items": [
        "Try-and-fail strategy registry replaces hardcoded if-cascade",
        "Bounded context per fragment: Symbol Navigator + Prior Memory (each <= 4KB)",
        "Repair loop iterates until validator converges or plateau stalls",
        "Conversable checkpointing for crash-safe idempotent resume"
      ]
    }
