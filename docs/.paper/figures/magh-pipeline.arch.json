  "cards": [
    {
      "dot": "cyan",
      "title": "Inputs",
      "items": [
        "YAML config picks source + target dirs and model pair",
        "Source repo lives under assets/samples/ or assets/manual-samples/"
      ]
    },
    {
      "dot": "emerald",
      "title": "Pipeline",
      "items": [
        "6 stages: Intake -> Analyze -> Plan -> Translate -> Validate -> Repair",
        "Translator is chunked with topological fragment order",
        "Validator drives a bounded coverage-plateau repair loop"
      ]
    },
    {
      "dot": "amber",
      "title": "Resilience",
      "items": [
        "Per-fragment checkpoint under .artifacts/<run-id>/checkpoints/",
        "Crash-resume: any run picks up at the last saved fragment",
        "All calls go through Ollama; no cloud API needed"
      ]
    }
  ]
