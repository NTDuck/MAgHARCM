    {
      "id": "planner-ollama",
      "from": "planner",
      "to": "ollama",
      "label": "reasoning LLM",
      "fromSide": "top",
      "toSide": "right"
    },
    {
      "id": "translator-ollama",
      "from": "translator",
      "to": "ollama",
      "label": "code LLM",
      "fromSide": "top",
      "toSide": "bottom"
