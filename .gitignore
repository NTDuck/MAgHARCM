# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

bin/
# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/


# env file
.env

# Editor/IDE
# .idea/
# .vscode/

examples/

# Artifacts
.artifacts/

# Default TUI save artifact (overridable via /save <path>).
magharcm-request.yml
# paper/ build artifacts
paper/main.aux
paper/main.bbl
paper/main.blg
paper/main.log
paper/main.out
paper/main.pdf

# Python plot script caches
paper/figures/__pycache__/
